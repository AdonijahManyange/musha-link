generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(STUDENT)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens   PasswordResetToken[]
  listings              Listing[]
  verification          LandlordVerification?
  verificationDocuments VerificationDocument[]
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// LANDLORD VERIFICATION
// ============================================================

model LandlordVerification {
  id String @id @default(cuid())

  landlordId String @unique
  landlord   User   @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  status VerificationStatus @default(PENDING)

  rejectionReason String?
  reviewedAt      DateTime?
  submittedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ============================================================
// VERIFICATION DOCUMENTS
// ============================================================

model VerificationDocument {
  id String @id @default(cuid())

  userId String

  type     VerificationDocumentType
  filePath String
  fileName String

  status VerificationStatus @default(PENDING)

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([status])
}

// ============================================================
// UNIVERSITY
// ============================================================

model University {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]
}

// ============================================================
// LISTING
// ============================================================

model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  landlordId String
  landlord   User   @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  title       String
  address     String
  city        String
  province    String
  country     String
  description String

  propertyType PropertyType @default(OTHER)

  latitude  Float?
  longitude Float?

  universityId String
  university   University @relation(fields: [universityId], references: [id])

  distanceToUniversityKm Float?

  monthlyRent Int

  roomType         RoomType
  genderPreference GenderPreference

  status   ListingStatus @default(DRAFT)
  isActive Boolean       @default(true)

  photos ListingPhoto[]

  @@index([landlordId])
  @@index([universityId])
  @@index([monthlyRent])
  @@index([roomType])
  @@index([genderPreference])
  @@index([propertyType])
  @@index([status])
  @@index([isActive])
}

// ============================================================
// LISTING PHOTO
// ============================================================

model ListingPhoto {
  id String @id @default(cuid())

  listingId String

  url      String
  fileName String

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, sortOrder])
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  LANDLORD
  ADMIN
}

enum VerificationDocumentType {
  ID
  UTILITY_BILL
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PropertyType {
  HOUSE
  FLAT
  APARTMENT
  TOWNHOUSE
  COTTAGE
  ROOMING_HOUSE
  OTHER
}

enum RoomType {
  PRIVATE
  SHARED
  ENTIRE_PROPERTY
}

enum GenderPreference {
  ANY
  MALE
  FEMALE
}
