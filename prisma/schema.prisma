generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String                 @unique
  password              String?
  role                  Role                   @default(STUDENT)
  verified              Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  landlordProfile       LandlordProfile?
  verification          LandlordVerification?
  listings              Listing[]
  passwordResetTokens   PasswordResetToken[]
  studentProfile        StudentProfile?
  verificationDocuments VerificationDocument[]

  sentMessages          Message[]      @relation("SentMessages")
  receivedMessages      Message[]      @relation("ReceivedMessages")
  studentConversations  Conversation[] @relation("StudentConversations")
  landlordConversations Conversation[] @relation("LandlordConversations")
  notifications         Notification[]
}

model LandlordProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  dateOfBirth     DateTime?
  phone           String?
  address         String?
  city            String?
  province        String?
  country         String?
  profilePhotoUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bio             String?
  coverPhotoUrl   String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  universityId    String?
  phone           String?
  city            String?
  province        String?
  country         String?
  profilePhotoUrl String?
  bio             String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  university      University? @relation(fields: [universityId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LandlordVerification {
  id                String             @id @default(cuid())
  landlordId        String             @unique
  status            VerificationStatus @default(PENDING)
  rejectionReason   String?
  reviewedAt        DateTime?
  submittedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  diditSessionId    String?
  faceMatchVerified Boolean            @default(false)
  identityVerified  Boolean            @default(false)
  livenessVerified  Boolean            @default(false)
  reviewedById      String?
  landlord          User               @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  @@index([status])
}

model VerificationDocument {
  id         String                   @id @default(cuid())
  userId     String
  type       VerificationDocumentType
  filePath   String
  fileName   String
  status     VerificationStatus       @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([status])
}

model University {
  id              String           @id @default(cuid())
  name            String           @unique
  city            String
  latitude        Float
  longitude       Float
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  logo            String?
  listings        Listing[]
  studentProfiles StudentProfile[]
}

model Listing {
  id                     String               @id @default(cuid())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  landlordId             String
  title                  String
  address                String
  description            String
  latitude               Float?
  longitude              Float?
  universityId           String
  distanceToUniversityKm Float?
  monthlyRent            Int
  roomType               RoomType
  genderPreference       GenderPreference
  isActive               Boolean              @default(true)
  city                   String
  country                String
  province               String
  propertyType           PropertyType         @default(OTHER)
  status                 ListingStatus        @default(DRAFT)
  amenities              Amenity[]
  suburb                 String?
  internetProvider       InternetProvider?
  waterDrinkable         Boolean?
  waterSource            WaterSource?
  additionalFees         String?
  depositAmount          Int?
  depositRequired        Boolean              @default(false)
  internetCharges        String?
  utilitiesIncluded      String?
  solarBackupCapacity    SolarBackupCapacity?
  landlord               User                 @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  university             University           @relation(fields: [universityId], references: [id])
  listingAmenities       ListingAmenity[]
  bathrooms              ListingBathroom[]
  photos                 ListingPhoto[]
  conversations          Conversation[]

  @@index([landlordId])
  @@index([universityId])
  @@index([monthlyRent])
  @@index([roomType])
  @@index([genderPreference])
  @@index([propertyType])
  @@index([status])
  @@index([isActive])
}

model ListingAmenity {
  id        String   @id @default(cuid())
  listingId String
  amenity   Amenity
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, amenity])
  @@index([listingId])
  @@index([amenity])
}

model ListingBathroom {
  id        String            @id @default(cuid())
  listingId String
  sortOrder Int               @default(0)
  location  BathroomLocation  @default(INSIDE)
  features  BathroomFeature[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  listing   Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, sortOrder])
}

model ListingPhoto {
  id        String         @id @default(cuid())
  listingId String
  url       String
  fileName  String
  sortOrder Int            @default(0)
  isCover   Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  category  PhotoCategory?
  listing   Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, sortOrder])
}

model Conversation {
  id String @id @default(cuid())

  studentId  String
  landlordId String
  listingId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  User    @relation("StudentConversations", fields: [studentId], references: [id], onDelete: Cascade)
  landlord User    @relation("LandlordConversations", fields: [landlordId], references: [id], onDelete: Cascade)
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([studentId, landlordId, listingId])
  @@index([studentId])
  @@index([landlordId])
  @@index([listingId])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  senderId       String
  recipientId    String

  content String

  read Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String

  type    NotificationType
  title   String
  message String

  read Boolean @default(false)

  // Where the user should go when they click
  // the notification.
  link String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

enum Role {
  STUDENT
  LANDLORD
  ADMIN
}

enum VerificationDocumentType {
  ID
  TITLE_DEED
  WATER_BILL
  ELECTRICITY_BILL
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PropertyType {
  HOUSE
  FLAT
  APARTMENT
  TOWNHOUSE
  COTTAGE
  ROOMING_HOUSE
  OTHER
}

enum RoomType {
  PRIVATE
  SHARED
  ENTIRE_PROPERTY
}

enum GenderPreference {
  ANY
  MALE
  FEMALE
}

enum Amenity {
  WIFI
  SOLAR_POWER
  BOREHOLE
  ELECTRICITY
  BACKUP_GENERATOR
  WATER
  SECURITY
  PARKING
  FURNISHED
  LAUNDRY
  KITCHEN
  STUDY_AREA
  GARDEN
  SWIMMING_POOL
  DSTV
  SMART_TV
  NETFLIX
  PRIME_VIDEO
}

enum BathroomLocation {
  INSIDE
  OUTSIDE
}

enum BathroomFeature {
  SHOWER
  BATHTUB
  TOILET
  SINK
}

enum PhotoCategory {
  LIVING_ROOM
  BEDROOM
  BATHROOM
  FRONT_YARD
  PARKING
  MAIN_ENTRANCE
  VERANDA
  BED
  CORRIDOR
  BACK_YARD
}

enum InternetProvider {
  LIQUID_HOME
  TELONE
  STARLINK
  UTANDE
  AFRICOM
  POWERTEL
  DANDEMUTANDE
  ZARNET
  ECONET
  NETONE
  TELECEL
  OTHER
  NONE
}

enum WaterSource {
  BOREHOLE_FRESH_WATER
  TAP_FRESH_WATER
  BOREHOLE_AND_TAP
  NO_RELIABLE_SUPPLY
  OTHER
}

enum SolarBackupCapacity {
  NONE
  BASIC_500VA_2KVA
  STANDARD_3_4KVA
  HIGH_CAPACITY_5_6KVA
  PREMIUM_7KVA_PLUS
}

enum NotificationType {
  NEW_MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_PUBLISHED
  VIEWING_REQUEST
  VIEWING_CONFIRMED
  VIEWING_CANCELLED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SYSTEM
}
